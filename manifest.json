{
  "manifest_version": 3,
  "name": "Keyword Blocker",
  "version": "1.1",
  "description": "Hides videos, posts and search results that contain keywords you choose.",
  "permissions": ["storage"],
  "action": {
    "default_title": "Keyword Blocker",
    "default_popup": "popup.html"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["defaults.js", "content.js"],
      "run_at": "document_idle"
    }
  ]
}
